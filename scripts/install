#!/bin/sh
set -eu

usage() {
  printf 'Usage: %s [--pi] [--claude] [--codex] [--cursor] [--experimental]\n' "$0"
  printf '  --pi            also install the Pi agents, extensions, themes and skills\n'
  printf '  --claude        also link Claude Code to the shared instructions and skills\n'
  printf '  --codex         also link Codex to the shared instructions\n'
  printf '  --cursor        also add the shared instructions as a Cursor global rule\n'
  printf '  --experimental  also install the skills under experimental/skills\n'
}

install_pi=false
install_experimental=false
install_claude=false
install_codex=false
install_cursor=false
for arg in "$@"; do
  case $arg in
    --pi) install_pi=true ;;
    --claude) install_claude=true ;;
    --codex) install_codex=true ;;
    --cursor) install_cursor=true ;;
    --experimental) install_experimental=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
agent_home=${AGENT_HOME:-"$HOME/.agents"}
pi_agent_home=${PI_AGENT_HOME:-"$HOME/.pi/agent"}
claude_home=${CLAUDE_HOME:-"$HOME/.claude"}
codex_home=${CODEX_HOME:-"$HOME/.codex"}
cursor_home=${CURSOR_HOME:-"$HOME/.cursor"}
context_templates="$agent_home/context/templates"
collisions=""

record_collision() {
  if [ -z "$collisions" ]; then
    collisions=$1
  else
    collisions="$collisions
$1"
  fi
}

check_destination() {
  if [ -e "$1" ] || [ -L "$1" ]; then
    record_collision "$1"
  fi
}

check_tree_entries() {
  source_dir=$1
  destination_dir=$2
  for source in "$source_dir"/*; do
    [ -e "$source" ] || continue
    check_destination "$destination_dir/$(basename -- "$source")"
  done
}

check_destination "$agent_home/AGENTS.md"
check_destination "$agent_home/model-policy.yaml"
check_destination "$agent_home/scripts/model-policy.py"
check_destination "$agent_home/scripts/find-sessions.py"
check_tree_entries "$repo_dir/skills" "$agent_home/skills"
if [ "$install_experimental" = true ]; then
  check_tree_entries "$repo_dir/experimental/skills" "$agent_home/skills"
fi
check_tree_entries "$repo_dir/context/templates" "$context_templates"

if [ "$install_pi" = true ]; then
  check_destination "$pi_agent_home/AGENTS.md"
  check_destination "$pi_agent_home/settings.example.json"
  check_destination "$pi_agent_home/modes.json"
  check_destination "$pi_agent_home/mcp.example.json"
  check_tree_entries "$repo_dir/pi/agents" "$pi_agent_home/agents"
  check_tree_entries "$repo_dir/pi/extensions" "$pi_agent_home/extensions"
  check_tree_entries "$repo_dir/pi/skills" "$pi_agent_home/skills"
  check_tree_entries "$repo_dir/pi/themes" "$pi_agent_home/themes"
fi

if [ "$install_claude" = true ]; then
  check_destination "$claude_home/CLAUDE.md"
  check_destination "$claude_home/skills"
fi

if [ "$install_codex" = true ]; then
  check_destination "$codex_home/AGENTS.md"
fi

if [ "$install_cursor" = true ]; then
  check_destination "$cursor_home/rules/agents.mdc"
fi

if [ -n "$collisions" ]; then
  printf '%s\n' 'Installation stopped because these destinations already exist:' >&2
  printf '%s\n' "$collisions" >&2
  exit 1
fi

install -d "$agent_home/skills" "$agent_home/scripts" "$context_templates"
cp "$repo_dir/AGENTS.md" "$agent_home/AGENTS.md"
if [ ! -e "$agent_home/USER.md" ] && [ ! -L "$agent_home/USER.md" ]; then
  cp "$repo_dir/templates/USER.md" "$agent_home/USER.md"
fi
cp "$repo_dir/model-policy.yaml" "$agent_home/model-policy.yaml"
cp "$repo_dir/scripts/model-policy.py" "$agent_home/scripts/model-policy.py"
cp "$repo_dir/scripts/find-sessions.py" "$agent_home/scripts/find-sessions.py"
cp -R "$repo_dir"/skills/* "$agent_home/skills/"
if [ "$install_experimental" = true ]; then
  cp -R "$repo_dir"/experimental/skills/* "$agent_home/skills/"
fi
cp "$repo_dir"/context/templates/* "$context_templates/"

if [ "$install_pi" = true ]; then
  install -d "$pi_agent_home/agents" "$pi_agent_home/extensions" "$pi_agent_home/skills" "$pi_agent_home/themes"
  ln -s "$agent_home/AGENTS.md" "$pi_agent_home/AGENTS.md"
  cp "$repo_dir/pi/settings.example.json" "$pi_agent_home/settings.example.json"
  cp "$repo_dir/pi/modes.json" "$pi_agent_home/modes.json"
  cp "$repo_dir/pi/mcp.example.json" "$pi_agent_home/mcp.example.json"
  cp -R "$repo_dir"/pi/agents/* "$pi_agent_home/agents/"
  cp -R "$repo_dir"/pi/extensions/* "$pi_agent_home/extensions/"
  cp -R "$repo_dir"/pi/skills/* "$pi_agent_home/skills/"
  cp -R "$repo_dir"/pi/themes/* "$pi_agent_home/themes/"
fi

if [ "$install_claude" = true ]; then
  install -d "$claude_home"
  ln -s "$agent_home/AGENTS.md" "$claude_home/CLAUDE.md"
  ln -s "$agent_home/skills" "$claude_home/skills"
fi

if [ "$install_codex" = true ]; then
  install -d "$codex_home"
  ln -s "$agent_home/AGENTS.md" "$codex_home/AGENTS.md"
fi

if [ "$install_cursor" = true ]; then
  install -d "$cursor_home/rules"
  {
    printf '%s\n' '---' 'description: Shared global instructions' 'alwaysApply: true' '---' ''
    printf '%s\n' 'This text is copied from the shared AGENTS.md in the agent home. Edit that file, then copy it here again.' ''
    cat "$agent_home/AGENTS.md"
  } > "$cursor_home/rules/agents.mdc"
fi

printf 'Installed agent setup in %s\n' "$agent_home"
if [ "$install_pi" = true ]; then
  printf 'Installed Pi setup in %s\n' "$pi_agent_home"
fi
if [ "$install_claude" = true ]; then
  printf 'Linked Claude Code in %s\n' "$claude_home"
fi
if [ "$install_codex" = true ]; then
  printf 'Linked Codex in %s\n' "$codex_home"
fi
if [ "$install_cursor" = true ]; then
  printf 'Added the Cursor rule in %s\n' "$cursor_home/rules"
fi
